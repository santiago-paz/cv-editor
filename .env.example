# Copy this file to .env.local and remove the # in front of each line you need.
# The editor runs with none of these. Sign-in and the AI button need every
# variable under "Accounts and AI".

# Where the PDF route finds Chrome, when it is not in a usual place.
# CHROME_PATH=/usr/bin/chromium

# Accounts and AI
# DATABASE_URL=
# A random secret. Make one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
# Set to 1 to turn the AI button off.
# AI_PAUSED=1

# The postal address the privacy page prints.
# OPERATOR_ADDRESS=

# The Donate link and the author's link in the CV menu. Only https addresses count.
# NEXT_PUBLIC_DONATE_URL=
# NEXT_PUBLIC_AUTHOR_URL=
